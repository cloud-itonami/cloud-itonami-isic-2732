(ns harnessworks.physics-probe
  "The physical-AI bot's measurement: run this actor's REAL `physics-2d`
  conductor/crimp tensile-pull simulation (`harnessworks.robotics/run-pull-test`)
  over a fixed sweep of crimp effective masses and print ONE EDN map of the
  physical quantities it computed.

    kbb -M:dev:physics

  This is what the resident bot (hermes/profiles/physai-isic-2732/SOUL.md)
  reads every tick. Every number is derived from a time-stepped trajectory
  by `harnessworks.robotics`, never typed in. Output schema
  `itonami.physical-ai.probe.v1`:

    {:physics-probe/schema \"itonami.physical-ai.probe.v1\"
     :repo      \"cloud-itonami/cloud-itonami-isic-2732\"
     :procedure \"...\"
     :solver    \"physics-2d/world-step\"
     :runs      [{:input {...} :quantities {...} :out-of-tolerance? bool} ...]
     :derived   {...}           ; quantities computed ACROSS runs
     :count     n               ; runs that produced numeric quantities
     :expected  n}

  `:count` is an evidence floor: 0 means \"could not measure\", never
  \"nothing out of tolerance\". Exit 0 when every run produced numbers,
  2 when any run did not."
  (:require [harnessworks.robotics :as robotics]))

(def schema "itonami.physical-ai.probe.v1")

(def sweep-crimp-masses-kg
  "Crimp effective masses swept each tick. 0.03 / 0.09 / 0.10 / 0.11 kg are
  the fixtures `harnessworks.store` seeds (0.03 is the under-crimped batch);
  0.05 brackets the pass/fail floor so a solver change shows up as a change
  in slope, not only in one point."
  [0.03 0.05 0.09 0.10 0.11])

(defn- telemetry [mass-kg]
  (robotics/pull-test-telemetry-for {:crimp-effective-mass-kg mass-kg}))

(defn- run-one [mass-kg]
  (let [t (telemetry mass-kg)]
    {:input {:crimp-effective-mass-kg mass-kg}
     :quantities t
     :out-of-tolerance? (robotics/pull-force-out-of-tolerance? t)}))

(defn min-passing-crimp-mass-kg
  "Smallest crimp effective mass whose simulated peak pull force reaches
  `robotics/min-pull-force-n`, by bisection over the REAL simulation (force
  is monotone in mass at fixed speed/travel -- pinned by physics_probe_test).
  nil when the bracket does not straddle the floor."
  ([] (min-passing-crimp-mass-kg 0.001 1.0 40))
  ([lo hi iters]
   (let [below? (fn [m] (robotics/pull-force-out-of-tolerance? (telemetry m)))]
     (when (and (below? lo) (not (below? hi)))
       (loop [lo lo hi hi i 0]
         (if (>= i iters)
           hi
           (let [mid (/ (+ lo hi) 2.0)]
             (if (below? mid)
               (recur mid hi (inc i))
               (recur lo mid (inc i))))))))))

(defn probe []
  (let [runs (mapv run-one sweep-crimp-masses-kg)
        numeric? (fn [r] (number? (get-in r [:quantities :sim-peak-pull-force-n])))]
    {:physics-probe/schema schema
     :repo "cloud-itonami/cloud-itonami-isic-2732"
     :procedure "IPC/WHMA-A-620 crimped-terminal tensile pull test (robot tensile-pull cell)"
     :solver "physics-2d/world-step"
     :runs runs
     :derived {:min-pull-force-n robotics/min-pull-force-n
               :min-passing-crimp-mass-kg (min-passing-crimp-mass-kg)}
     :count (count (filter numeric? runs))
     :expected (count sweep-crimp-masses-kg)}))

(defn -main [& _]
  (let [p (probe)]
    (prn p)
    (when-not (= (:count p) (:expected p))
      #?(:cljs (set! (.-exitCode js/process) 2)
         :default (System/exit 2)))))
